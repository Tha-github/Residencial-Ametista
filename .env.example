# Copie para `.env` (desenvolvimento) e preencha. Nunca versione `.env` nem `.dev.vars`.
# Em produção, configure estes nomes no painel da Cloudflare (Worker → Settings → Variables)
# ou com `wrangler secret put NOME` para os itens marcados como segredo.

# URL pública canônica do site, sem barra final (ex.: domínio definitivo do residencial).
PUBLIC_SITE_URL=

# development | preview | production
# Somente `production` permite indexação por buscadores e oculta avisos de pendência.
PUBLIC_DEPLOY_ENV=development

# --- Painel administrativo (Etapa 6) — segredos, somente no servidor ---
# Domínio da equipe no Cloudflare Zero Trust (ex.: <equipe>.cloudflareaccess.com)
CF_ACCESS_TEAM_DOMAIN=
# Application Audience (AUD) tag da aplicação Access que protege /admin
CF_ACCESS_AUD=
# E-mail único autorizado também validado pelo Worker (além da política Access).
ADMIN_ALLOWED_EMAIL=
