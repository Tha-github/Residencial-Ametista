{
  "name": "residencial-ametista",
  "type": "module",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "\u003e=22.23.4"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "astro": "astro",
    "typecheck": "astro check",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "validate": "npm run typecheck \u0026\u0026 npm run lint \u0026\u0026 npm run format:check \u0026\u0026 npm run test \u0026\u0026 npm run build",
    "deploy:cloudflare": "npm run validate \u0026\u0026 wrangler deploy",
    "generate-types": "wrangler types",
    "test:e2e": "playwright test",
    "admin:hash-password": "node scripts/hash-admin-password.mjs",
    "admin:dev": "wrangler dev --config admin-worker/wrangler.jsonc",
    "admin:deploy": "wrangler deploy --config admin-worker/wrangler.jsonc"
  },
  "dependencies": {
    "@astrojs/cloudflare": "^14.4.8",
    "astro": "^7.4.12",
    "wrangler": "^4.163.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.65.1",
    "@types/node": "^24.19.2",
    "eslint": "^10.15.0",
    "eslint-plugin-astro": "^3.2.1",
    "eslint-plugin-jsx-a11y-x": "^0.2.0",
    "globals": "^17.14.0",
    "prettier": "^3.10.1",
    "prettier-plugin-astro": "^1.1.2",
    "sharp": "^0.35.5",
    "typescript": "~6.0",
    "typescript-eslint": "^8.73.0",
    "vitest": "^5.1.0"
  },
  "overrides": {
    "eslint-plugin-jsx-a11y-x": {
      "minimatch": "^11.0.8"
    }
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "workerd@1.20261110.1": true,
    "workerd@1.20261116.1": true
  }
}
