---
/** Capacidade e comodidades — cada item só aparece se confirmado. */
import type { PropertyContent } from '../../data/property.schema';
import Section from '../layout/Section.astro';

interface Props {
  content: PropertyContent;
}

const { content } = Astro.props;
const { facts, amenities } = content;

const plural = (n: number, one: string, many: string) => `${n} ${n === 1 ? one : many}`;
const factRows = [
  facts.maxGuests !== undefined && {
    label: 'Hóspedes',
    value: `até ${plural(facts.maxGuests, 'pessoa', 'pessoas')}`,
  },
  facts.bedrooms !== undefined && {
    label: 'Quartos',
    value: plural(facts.bedrooms, 'quarto', 'quartos'),
  },
  facts.beds && { label: 'Camas', value: facts.beds },
  facts.bathrooms !== undefined && {
    label: 'Banheiros',
    value: plural(facts.bathrooms, 'banheiro', 'banheiros'),
  },
  facts.areaM2 !== undefined && {
    label: 'Área',
    value: `${facts.areaM2.toLocaleString('pt-BR')} m²`,
  },
].filter((row): row is { label: string; value: string } => Boolean(row));
---

<Section id="comodidades" eyebrow="Estrutura" title="Espaço e comodidades">
  <div class="amenities">
    {factRows.length > 0 && (
      <dl class="facts reveal">
        {factRows.map((row) => (
          <div class="fact">
            <dt>{row.label}</dt>
            <dd>{row.value}</dd>
          </div>
        ))}
      </dl>
    )}
    {amenities.length > 0 && (
      <div class="reveal">
        <h3 class="amenities__title">O que o residencial oferece</h3>
        <ul class="amenity-list" role="list">
          {amenities.map((item) => (
            <li>{item}</li>
          ))}
        </ul>
      </div>
    )}
  </div>
</Section>

<style>
  .amenities {
    display: grid;
    gap: var(--space-8);
  }
  @media (min-width: 1024px) {
    .amenities {
      grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
      align-items: start;
    }
  }
  .facts {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--space-5) var(--space-4);
    padding: var(--space-6);
    background: var(--color-surface);
    border-radius: var(--radius-lg);
  }
  .fact {
    display: grid;
    gap: var(--space-1);
    align-content: start; /* valores alinhados ao topo mesmo com vizinho de várias linhas */
  }
  dt {
    font-size: var(--text-xs);
    font-weight: var(--font-weight-strong);
    letter-spacing: var(--tracking-eyebrow);
    text-transform: uppercase;
    color: var(--color-text-muted);
  }
  dd {
    margin: 0;
    font-family: var(--font-display);
    font-size: var(--text-xl);
    line-height: var(--leading-snug);
    color: var(--color-heading);
  }
  .amenities__title {
    margin-bottom: var(--space-5);
  }
  .amenity-list {
    display: grid;
    gap: var(--space-3) var(--space-6);
    padding: 0;
    list-style: none;
  }
  @media (min-width: 480px) {
    .amenity-list {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  .amenity-list li {
    display: flex;
    gap: var(--space-3);
    align-items: baseline;
    padding-bottom: var(--space-3);
    border-bottom: var(--border-width) solid var(--color-border);
  }
  .amenity-list li::before {
    content: '';
    flex: none;
    inline-size: 6px;
    block-size: 6px;
    border-radius: 50%;
    background: var(--color-eyebrow);
    transform: translateY(-2px);
  }
</style>
