---
/**
 * Estrutura e comodidades — lista completa do que foi confirmado, com a
 * capacidade do apartamento (números em serifa) ao lado do título.
 */
import type { PropertyContent } from '../../data/property.schema';
import Section from '../layout/Section.astro';
import Icon from '../ui/Icon.astro';
import SectionHeading from '../ui/SectionHeading.astro';

interface Props {
  content: PropertyContent;
}

const { content } = Astro.props;
const { facts, amenities } = content;

const plural = (n: number, one: string, many: string) => `${n} ${n === 1 ? one : many}`;
const factRows = [
  facts.maxGuests !== undefined && {
    label: 'Hóspedes',
    value: `até ${plural(facts.maxGuests, 'pessoa', 'pessoas')}`,
  },
  facts.bedrooms !== undefined && {
    label: 'Quartos',
    value: plural(facts.bedrooms, 'quarto', 'quartos'),
  },
  facts.beds && { label: 'Camas', value: facts.beds },
  facts.bathrooms !== undefined && {
    label: 'Banheiros',
    value: plural(facts.bathrooms, 'banheiro', 'banheiros'),
  },
  facts.areaM2 !== undefined && {
    label: 'Área',
    value: `${facts.areaM2.toLocaleString('pt-BR')} m²`,
  },
].filter((row): row is { label: string; value: string } => Boolean(row));
---

<Section id="comodidades" title="Comodidades" surface="sand" customHeading>
  <div class="amenities">
    <div class="amenities__intro">
      <SectionHeading
        id="comodidades-titulo"
        eyebrow={content.sections.amenities.eyebrow}
        title={content.sections.amenities.title}
      >
        {content.sections.amenities.lead}
      </SectionHeading>
      {factRows.length > 0 && (
        <dl class="facts reveal">
          {factRows.map((row) => (
            <div class="fact">
              <dt>{row.label}</dt>
              <dd>{row.value}</dd>
            </div>
          ))}
        </dl>
      )}
    </div>
    {amenities.length > 0 && (
      <ul class="amenity-list reveal" role="list">
        {amenities.map((item) => (
          <li>
            <Icon name="check" size={18} strokeWidth={2} />
            <span>{item}</span>
          </li>
        ))}
      </ul>
    )}
  </div>
</Section>

<style>
  .amenities {
    display: grid;
    gap: var(--space-7);
  }
  @media (min-width: 1024px) {
    .amenities {
      grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
      gap: var(--space-9);
      align-items: start;
    }
  }
  .amenities__intro :global(.section-heading) {
    margin-bottom: var(--space-6);
  }

  .facts {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--space-5) var(--space-4);
    padding-top: var(--space-5);
    border-top: var(--border-width) solid var(--color-border);
  }
  .fact {
    display: grid;
    gap: var(--space-1);
    align-content: start;
    justify-items: center;
    text-align: center;
  }
  dt {
    font-size: var(--text-xs);
    font-weight: var(--font-weight-strong);
    letter-spacing: var(--tracking-eyebrow);
    text-transform: uppercase;
    color: var(--color-text-muted);
  }
  dd {
    margin: 0;
    font-family: var(--font-display);
    font-size: var(--text-xl);
    line-height: var(--leading-snug);
    color: var(--color-heading);
  }

  /* Colunas de jornal: cada coluna flui sem linhas desalinhadas */
  .amenity-list {
    padding: 0;
    list-style: none;
  }
  @media (min-width: 640px) {
    .amenity-list {
      columns: 2;
      column-gap: var(--space-7);
    }
  }
  .amenity-list li {
    break-inside: avoid;
    display: flex;
    gap: var(--space-3);
    align-items: flex-start;
    padding-block: var(--space-3);
    border-bottom: var(--border-width) solid var(--color-border);
  }
  .amenity-list :global(svg) {
    flex: none;
    margin-top: 3px;
    color: var(--color-accent);
  }
</style>
