---
/**
 * Diferenciais confirmados em caixas individuais, com conteúdo centralizado:
 * ícone fino, título e descrição curta. Grade 3 × 2 no desktop, 2 colunas
 * no tablet e 1 no celular.
 */
import type { PropertyContent } from '../../data/property.schema';
import Section from '../layout/Section.astro';
import Icon from '../ui/Icon.astro';

interface Props {
  content: PropertyContent;
}

const { content } = Astro.props;
---

<Section
  id="diferenciais"
  eyebrow="Diferenciais"
  title="O que faz *diferença* na sua estadia"
  lead="Os detalhes que deixam a hospedagem mais prática, confortável e com cara de casa de praia."
  align="center"
>
  <ul class="highlights" role="list">
    {content.highlights.map((item) => (
      <li class="highlight reveal">
        <span class="highlight__icon">
          <Icon name={item.icon ?? 'waves'} size={24} />
        </span>
        <h3 class="highlight__title">{item.title}</h3>
        {item.text && <p class="highlight__text">{item.text}</p>}
      </li>
    ))}
  </ul>
</Section>

<style>
  .highlights {
    display: grid;
    gap: var(--space-4);
    padding: 0;
    list-style: none;
  }
  @media (min-width: 640px) {
    .highlights {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: var(--space-5);
    }
  }
  @media (min-width: 1024px) {
    .highlights {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  .highlight {
    display: grid;
    justify-items: center;
    align-content: start;
    gap: var(--space-3);
    padding: var(--space-7) var(--space-6);
    border-radius: var(--radius-lg);
    background: var(--color-surface);
    text-align: center;
    /* `translate` (e não `transform`): não briga com a animação .reveal */
    transition:
      translate var(--duration-base) var(--ease-out),
      box-shadow var(--duration-base) var(--ease-out),
      background-color var(--duration-base) var(--ease-out);
  }
  @media (max-width: 639px) {
    .highlight {
      padding: var(--space-6) var(--space-5);
    }
  }
  @media (hover: hover) {
    .highlight:hover {
      translate: 0 -3px;
      background: var(--color-surface-raised);
      box-shadow: var(--shadow-md);
    }
  }
  .highlight__icon {
    display: grid;
    place-items: center;
    inline-size: 52px;
    block-size: 52px;
    margin-bottom: var(--space-1);
    border-radius: 50%;
    background: var(--color-bg);
    color: var(--color-eyebrow);
  }
  .highlight__title {
    font-size: var(--text-xl);
    line-height: var(--leading-snug);
  }
  .highlight__text {
    max-inline-size: 30ch;
    font-size: var(--text-sm);
    color: var(--color-text-muted);
  }
</style>
