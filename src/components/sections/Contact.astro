---
/**
 * Reserva direta / contato com o proprietário — somente canais fornecidos.
 * WhatsApp abre a conversa com mensagem pronta; e-mail abre o cliente de
 * e-mail. O site não confirma reservas: datas e valores são combinados
 * diretamente com o proprietário.
 */
import type { PropertyContent } from '../../data/property.schema';
import { instagramHandle, whatsappNumber } from '../../lib/content/format';
import Section from '../layout/Section.astro';
import Icon from '../ui/Icon.astro';

interface Props {
  content: PropertyContent;
}

const { content } = Astro.props;
const { instagram, whatsapp, email } = content.contact;
const phone = whatsapp ? whatsappNumber(whatsapp) : undefined;
---

<Section
  id="contato"
  eyebrow="Reserva direta"
  title="Fale direto com o *proprietário*"
  lead="Prefere combinar tudo sem intermediários? Entre em contato para consultar datas, valores e tirar suas dúvidas."
  align="center"
>
  <ul class="channels" role="list">
    {whatsapp && (
      <li>
        <a
          class="channel channel--primary"
          href={whatsapp}
          target="_blank"
          rel="noopener noreferrer"
        >
          <span class="channel__icon">
            <Icon name="message" size={24} />
          </span>
          <span class="channel__text">
            <span class="channel__label">WhatsApp</span>
            <span class="channel__value">{phone ?? 'Enviar mensagem'}</span>
            <span class="channel__hint">Enviar mensagem</span>
          </span>
          <span class="sr-only">(abre em nova aba)</span>
        </a>
      </li>
    )}
    {email && (
      <li>
        <a class="channel" href={`mailto:${email}`}>
          <span class="channel__icon">
            <Icon name="mail" size={24} />
          </span>
          <span class="channel__text">
            <span class="channel__label">E-mail</span>
            <span class="channel__value channel__value--email">
              {email.split('@')[0]}@<wbr />
              {email.split('@')[1]}
            </span>
            <span class="channel__hint">Escrever e-mail</span>
          </span>
        </a>
      </li>
    )}
    {instagram && (
      <li>
        <a class="channel" href={instagram} target="_blank" rel="noopener noreferrer">
          <span class="channel__icon">
            <Icon name="camera" size={24} />
          </span>
          <span class="channel__text">
            <span class="channel__label">Instagram</span>
            <span class="channel__value">{instagramHandle(instagram)}</span>
            <span class="channel__hint">Ver perfil</span>
          </span>
          <span class="sr-only">(abre em nova aba)</span>
        </a>
      </li>
    )}
  </ul>
</Section>

<style>
  .channels {
    display: grid;
    gap: var(--space-4);
    max-inline-size: 48rem;
    margin-inline: auto;
    padding: 0;
    list-style: none;
  }
  @media (min-width: 768px) {
    .channels {
      grid-template-columns: repeat(auto-fit, minmax(16rem, 1fr));
      gap: var(--space-5);
    }
  }
  .channel {
    display: grid;
    justify-items: center;
    gap: var(--space-3);
    block-size: 100%;
    min-block-size: var(--tap-min);
    padding: var(--space-7) var(--space-5);
    border-radius: var(--radius-lg);
    background: var(--color-surface);
    color: var(--color-heading);
    text-align: center;
    text-decoration: none;
    transition:
      translate var(--duration-base) var(--ease-out),
      box-shadow var(--duration-base) var(--ease-out),
      background-color var(--duration-fast) var(--ease-out);
  }
  .channel:hover {
    translate: 0 -3px;
    background: var(--color-surface-raised);
    box-shadow: var(--shadow-md);
  }
  /* Canal principal (WhatsApp) em mar profundo */
  .channel--primary {
    background:
      radial-gradient(120% 90% at 100% 0%, var(--sea-700) 0%, transparent 65%), var(--sea-900);
    color: var(--sand-50);
  }
  .channel--primary:hover {
    background:
      radial-gradient(120% 90% at 100% 0%, var(--sea-600) 0%, transparent 65%), var(--sea-900);
  }
  .channel--primary:focus-visible {
    outline-color: var(--sea-900);
  }
  .channel__icon {
    display: grid;
    place-items: center;
    inline-size: 52px;
    block-size: 52px;
    border-radius: 50%;
    background: var(--color-bg);
    color: var(--color-eyebrow);
  }
  .channel--primary .channel__icon {
    background: rgb(255 255 255 / 0.1);
    color: var(--terra-300);
  }
  .channel__text {
    display: grid;
    gap: var(--space-1);
    min-inline-size: 0;
  }
  .channel__label {
    font-size: var(--text-xs);
    font-weight: var(--font-weight-strong);
    letter-spacing: var(--tracking-eyebrow);
    text-transform: uppercase;
    color: var(--color-text-muted);
  }
  .channel--primary .channel__label {
    color: var(--sea-200);
  }
  .channel__value {
    font-family: var(--font-display);
    font-size: var(--text-xl);
    line-height: var(--leading-snug);
    overflow-wrap: anywhere;
  }
  /* E-mail é longo: um pouco menor e quebra só no "@" se faltar espaço */
  .channel__value--email {
    font-size: var(--text-lg);
    overflow-wrap: normal;
  }
  .channel__hint {
    margin-top: var(--space-2);
    font-size: var(--text-sm);
    font-weight: var(--font-weight-strong);
    color: var(--color-accent);
  }
  .channel--primary .channel__hint {
    color: var(--terra-300);
  }
</style>
