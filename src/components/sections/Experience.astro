---
/**
 * "Um dia de férias": sugestão de como aproveitar a hospedagem em três
 * momentos (manhã, tarde, noite), com fotos reais do imóvel e texto curto.
 * Linha do tempo sobre o mar profundo — composição diferente da grade de
 * diferenciais. Desktop: três colunas ligadas por uma linha fina.
 * Mobile: momentos empilhados e centralizados.
 */
import type { PropertyContent } from '../../data/property.schema';
import Section from '../layout/Section.astro';
import Photo from '../media/Photo.astro';
import Icon from '../ui/Icon.astro';

interface Props {
  content: PropertyContent;
}

const { content } = Astro.props;
const { moments } = content.experience;
---

<Section
  id="experiencia"
  eyebrow="Sugestão de roteiro"
  title={`Um dia de férias no *${content.name}*`}
  lead="Uma ideia de como aproveitar cada momento da hospedagem, da manhã à noite."
  surface="inverse"
  class="experience"
>
  <ol class="day" data-count={moments.length}>
    {moments.map((m, i) => (
      <li class="moment reveal">
        <div class="moment__marker">
          <span class="moment__icon">
            <Icon name={m.icon ?? 'sun'} size={22} />
          </span>
          {m.time && <p class="moment__time">{m.time}</p>}
        </div>
        <div class="moment__photo">
          <Photo
            src={m.photo.src}
            alt={m.photo.alt}
            focus={m.photo.focus}
            aspect="4 / 3"
            sizes="(min-width: 1024px) 30vw, (min-width: 640px) 60vw, 92vw"
          />
        </div>
        <div class="moment__body">
          <h3 class="moment__title">{m.title}</h3>
          <p class="moment__text">{m.text}</p>
        </div>
        <span class="sr-only">
          Momento {i + 1} de {moments.length}
        </span>
      </li>
    ))}
  </ol>
</Section>

<style>
  /* A classe chega pela casca <Section>: seletor global para o escopo valer */
  :global(.section.experience) {
    background:
      radial-gradient(90% 60% at 100% 0%, rgb(26 100 136 / 0.35) 0%, transparent 70%),
      var(--sea-900);
  }

  .day {
    display: grid;
    gap: var(--space-8);
    padding: 0;
    list-style: none;
  }
  @media (min-width: 1024px) {
    .day {
      position: relative;
      grid-template-columns: repeat(var(--cols, 3), minmax(0, 1fr));
      gap: var(--grid-gap);
    }
    .day[data-count='2'] {
      --cols: 2;
    }
    /* Linha do tempo ligando os marcadores */
    .day::before {
      content: '';
      position: absolute;
      inset-inline: 22px;
      inset-block-start: 22px;
      block-size: 1px;
      background: linear-gradient(
        90deg,
        rgb(227 162 124 / 0.6),
        rgb(219 233 239 / 0.25) 50%,
        rgb(227 162 124 / 0.6)
      );
    }
  }

  .moment {
    display: grid;
    align-content: start;
    gap: var(--space-5);
  }
  @media (max-width: 1023px) {
    .moment {
      justify-items: center;
      max-inline-size: 34rem;
      margin-inline: auto;
      text-align: center;
    }
  }

  .moment__marker {
    position: relative;
    display: flex;
    align-items: center;
    gap: var(--space-3);
  }
  .moment__icon {
    display: grid;
    place-items: center;
    inline-size: 44px;
    block-size: 44px;
    border: var(--border-width) solid rgb(227 162 124 / 0.6);
    border-radius: 50%;
    background: var(--sea-900);
    color: var(--terra-300);
  }
  .moment__time {
    font-family: var(--font-display);
    font-size: var(--text-2xl);
    font-style: italic;
    line-height: 1;
    color: var(--terra-300);
  }
  @media (min-width: 1024px) {
    .moment__time {
      padding-inline-end: var(--space-3);
      background: var(--sea-900);
    }
  }

  /* Proporção fixa na moldura: a altura não muda quando a foto carrega (sem CLS) */
  .moment__photo {
    inline-size: 100%;
    aspect-ratio: 4 / 3;
    overflow: hidden;
    border-radius: var(--radius-lg);
    background: var(--sea-800);
  }
  .moment__photo :global(picture) {
    display: block;
    block-size: 100%;
  }
  .moment__photo :global(.photo) {
    block-size: 100%;
  }
  .moment__body {
    display: grid;
    gap: var(--space-2);
  }
  .moment__title {
    font-size: var(--text-2xl);
  }
  /* rem (e não ch): a largura não muda quando a fonte web substitui a reserva */
  .moment__text {
    max-inline-size: 24rem;
    color: var(--color-inverse-muted);
  }
  @media (max-width: 1023px) {
    .moment__text {
      margin-inline: auto;
    }
  }
</style>
