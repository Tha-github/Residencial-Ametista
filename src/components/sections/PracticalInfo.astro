---
/**
 * Respostas rápidas para quem está decidindo. Em destaque: horários
 * (check-in/out) e as condições que mais pesam (pets, crianças — itens
 * `featured`). Depois, os demais itens em grade de leitura rápida.
 * Somente o que foi confirmado; nada escondido em texto longo.
 */
import type { PropertyContent } from '../../data/property.schema';
import Section from '../layout/Section.astro';
import Icon from '../ui/Icon.astro';

interface Props {
  content: PropertyContent;
}

const { content } = Astro.props;
const { checkIn, checkOut, houseRules } = content.practicalInfo;
const times = [
  checkIn && { label: 'Check-in', value: checkIn },
  checkOut && { label: 'Check-out', value: checkOut },
].filter((t): t is { label: string; value: string } => Boolean(t));
const featured = content.essentials.filter((e) => e.featured);
const regular = content.essentials.filter((e) => !e.featured);
---

<Section
  id="informacoes"
  eyebrow={content.sections.info.eyebrow}
  title={content.sections.info.title}
  lead={content.sections.info.lead}
  surface="sand"
  align="center"
>
  {(times.length > 0 || featured.length > 0) && (
    <div class="key" data-count={times.length + featured.length}>
      {times.map((t) => (
        <div class="key__card key__card--time reveal">
          <span class="key__icon">
            <Icon name="clock" size={22} />
          </span>
          <p class="key__label">{t.label}</p>
          <p class="key__value numeral">{t.value}</p>
          {t.label === 'Check-in' && (
            <p class="key__note">Avise o horário previsto de chegada com antecedência.</p>
          )}
        </div>
      ))}
      {featured.map((e) => (
        <div class="key__card reveal">
          <span class="key__icon">
            <Icon name={e.icon} size={22} />
          </span>
          <p class="key__label">{e.label}</p>
          <p class="key__text">{e.value}</p>
        </div>
      ))}
    </div>
  )}

  {regular.length > 0 && (
    <dl class="facts">
      {regular.map((e) => (
        <div class="facts__item reveal">
          <span class="facts__icon">
            <Icon name={e.icon} size={20} />
          </span>
          <div>
            <dt>{e.label}</dt>
            <dd>{e.value}</dd>
          </div>
        </div>
      ))}
    </dl>
  )}

  {houseRules.length > 0 && (
    <div class="rules reveal">
      <h3 class="rules__title">Regras da casa</h3>
      <ul class="rules__list">
        {houseRules.map((rule) => (
          <li>{rule}</li>
        ))}
      </ul>
    </div>
  )}

  <p class="info__note">
    Condições de cancelamento, valores e outras políticas são as informadas em cada plataforma de
    reserva.
  </p>
</Section>

<style>
  /* ---------- Destaques ---------- */
  .key {
    display: grid;
    gap: var(--space-4);
    margin-bottom: var(--space-8);
  }
  @media (min-width: 768px) {
    .key {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  @media (min-width: 1024px) {
    .key[data-count='3'],
    .key[data-count='5'],
    .key[data-count='6'] {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
    .key[data-count='4'] {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
  }
  .key__card {
    display: grid;
    align-content: start;
    gap: var(--space-2);
    padding: var(--space-6);
    border-radius: var(--radius-lg);
    background: var(--color-surface-raised);
    box-shadow: var(--shadow-sm);
  }
  .key__card--time {
    background:
      radial-gradient(120% 90% at 100% 0%, var(--sea-700) 0%, transparent 65%), var(--sea-900);
    color: var(--color-inverse-text);
  }
  .key__icon {
    display: grid;
    place-items: center;
    inline-size: 44px;
    block-size: 44px;
    margin-bottom: var(--space-2);
    border-radius: 50%;
    background: var(--color-surface);
    color: var(--color-eyebrow);
  }
  .key__card--time .key__icon {
    background: rgb(255 255 255 / 0.1);
    color: var(--terra-300);
  }
  .key__label {
    font-size: var(--text-xs);
    font-weight: var(--font-weight-strong);
    letter-spacing: var(--tracking-eyebrow);
    text-transform: uppercase;
    color: var(--color-text-muted);
  }
  .key__card--time .key__label {
    color: var(--sea-200);
  }
  .key__value {
    font-size: var(--text-3xl);
    color: var(--sand-50);
  }
  .key__note {
    font-size: var(--text-sm);
    color: var(--sea-100);
  }
  .key__text {
    font-family: var(--font-display);
    font-size: var(--text-lg);
    line-height: var(--leading-snug);
    color: var(--color-heading);
  }

  /* ---------- Demais respostas ---------- */
  .facts {
    display: grid;
    gap: 0 var(--space-7);
  }
  @media (min-width: 640px) {
    .facts {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  @media (min-width: 1024px) {
    .facts {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }
  .facts__item {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    gap: var(--space-4);
    align-items: start;
    padding-block: var(--space-4);
    border-top: var(--border-width) solid var(--sand-300);
  }
  .facts__icon {
    margin-top: 2px;
    color: var(--color-accent);
  }
  dt {
    font-size: var(--text-xs);
    font-weight: var(--font-weight-strong);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-text-muted);
  }
  dd {
    margin: var(--space-1) 0 0;
    color: var(--color-heading);
  }

  .rules {
    margin-top: var(--space-7);
  }
  .rules__title {
    margin-bottom: var(--space-4);
  }
  .rules__list {
    display: grid;
    gap: var(--space-3);
    padding-inline-start: var(--space-5);
  }
  .rules__list li::marker {
    color: var(--color-eyebrow);
  }
  .info__note {
    margin-top: var(--space-7);
    max-width: var(--width-prose);
    font-size: var(--text-sm);
    color: var(--color-text-muted);
  }
</style>
