---
/**
 * Tour pelo apartamento: todas as fotos reais num único carrossel, na ordem
 * dos ambientes (`rooms`), seguidas das fotos que não estão em nenhum
 * ambiente. Os ambientes viram atalhos e legenda de cada foto.
 * Sem fotos (só em desenvolvimento): grade de placeholders.
 */
import type { PropertyContent } from '../../data/property.schema';
import { orderGallery, type GalleryPhoto } from '../../lib/media/gallery';
import { prepareLightboxItems } from '../../lib/media/prepare';
import Section from '../layout/Section.astro';
import GalleryGrid from '../media/GalleryGrid.astro';
import PhotoCarousel, { type CarouselRoom } from '../media/PhotoCarousel.astro';

interface Props {
  content: PropertyContent;
  /** Fotos já resolvidas (usado só pelas amostras de desenvolvimento). */
  photos?: GalleryPhoto[];
}

const { content, photos = content.media.gallery } = Astro.props;

// Fotos de cada ambiente (somente as que existem na galeria).
const bySrc = new Map(
  photos.filter((p) => typeof p.src === 'string').map((p) => [p.src as string, p]),
);
const roomPhotos = content.rooms
  .map((room) => ({
    title: room.title,
    list: [...new Set(room.photos)].flatMap((src) => bySrc.get(src) ?? []),
  }))
  .filter((room) => room.list.length > 0);

// Ordem do carrossel = ordem dos ambientes; depois, o restante da galeria.
const inRooms = [...new Set(roomPhotos.flatMap((r) => r.list))];
const sequence = [...inRooms, ...orderGallery(photos).filter((p) => !inRooms.includes(p))];
const items = await prepareLightboxItems(sequence);

const labels = sequence.map(
  (p) => roomPhotos.find((r) => r.list.includes(p))?.title ?? p.caption ?? '',
);
const rooms: CarouselRoom[] = roomPhotos.map((r) => ({
  title: r.title,
  start: sequence.indexOf(r.list[0]),
}));
---

<Section
  id="galeria"
  eyebrow="Tour pelo apartamento"
  title="Azul de mar em *cada canto*"
  lead="As paredes azuis, a luz natural e as almofadas de cor coral deixam o apartamento com cara de verão o ano todo. Escolha um ambiente e passeie por ele."
  surface="sand"
  align="center"
>
  {items.length > 0 ? (
    <PhotoCarousel items={items} labels={labels} rooms={rooms} />
  ) : (
    <GalleryGrid photos={[]} />
  )}
</Section>
