---
/**
 * Tour pelo apartamento: todas as fotos reais num único carrossel, na ordem
 * da galeria (editável no painel). Cada foto pode pertencer a um ambiente
 * (`room`): o nome do ambiente vira legenda e atalho no carrossel.
 * Sem fotos (só em desenvolvimento): grade de placeholders.
 */
import type { PropertyContent } from '../../data/property.schema';
import type { GalleryPhoto } from '../../lib/media/gallery';
import { prepareLightboxItems } from '../../lib/media/prepare';
import Section from '../layout/Section.astro';
import GalleryGrid from '../media/GalleryGrid.astro';
import PhotoCarousel, { type CarouselRoom } from '../media/PhotoCarousel.astro';

interface Props {
  content: PropertyContent;
  /** Fotos já resolvidas (usado só pelas amostras de desenvolvimento). */
  photos?: GalleryPhoto[];
}

const { content, photos = content.media.gallery } = Astro.props;
const text = content.sections.tour;

const items = await prepareLightboxItems(photos);
const roomTitle = new Map(content.rooms.map((r) => [r.id, r.title]));
const labels = photos.map((p) => (p.room && roomTitle.get(p.room)) || p.caption || '');
// Atalho de cada ambiente = primeira foto dele no carrossel (na ordem dos ambientes).
const rooms: CarouselRoom[] = content.rooms.flatMap((r) => {
  const start = photos.findIndex((p) => p.room === r.id);
  return start >= 0 ? [{ title: r.title, start }] : [];
});
---

<Section
  id="galeria"
  eyebrow={text.eyebrow}
  title={text.title}
  lead={text.lead}
  surface="sand"
  align="center"
>
  {items.length > 0 ? (
    <PhotoCarousel items={items} labels={labels} rooms={rooms} />
  ) : (
    <GalleryGrid photos={[]} />
  )}
</Section>
