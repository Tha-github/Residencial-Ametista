---
/**
 * Hero fotográfico. Nome, local, frase de experiência, números que decidem
 * a escolha (praia, área, quartos, banheiros) e dois CTAs: reserva e tour.
 * A faixa de informações rápidas (QuickFacts) sobrepõe a base do hero.
 *
 * Sem foto real:
 *  - fora de produção → placeholder identificado;
 *  - em produção → hero tipográfico sobre "mar profundo" (nunca foto genérica).
 */
import type { ImageMetadata } from 'astro';
import type { PropertyContent } from '../../data/property.schema';
import { hasBookingLinks } from '../../lib/content/sections';
import Photo from '../media/Photo.astro';
import PhotoPlaceholder from '../media/PhotoPlaceholder.astro';
import Button from '../ui/Button.astro';
import Icon from '../ui/Icon.astro';

interface Props {
  content: PropertyContent;
  /** Imagem já importada (usada só pelas amostras de desenvolvimento). */
  heroImage?: ImageMetadata;
  /** A faixa de informações rápidas vem logo abaixo (reserva espaço). */
  withStrip?: boolean;
}

const { content, heroImage, withStrip = false } = Astro.props;
const { location, media, description, facts } = content;

const hero = media.hero;
// CTAs só existem quando o destino existe (em qualquer ambiente):
// nunca um botão que leva a uma seção ausente.
const showBookingCta = hasBookingLinks(content);
const tourTarget =
  media.gallery.length > 0 ? '#galeria' : description.length > 0 ? '#apresentacao' : undefined;

const place = [location.beach, location.city].filter(Boolean).join(' · ');

// Apresentação: a última palavra do nome em itálico (ex.: "Residencial *Ametista*").
const words = content.name.trim().split(/\s+/);
const nameLead = words.slice(0, -1).join(' ');
const nameLast = words.at(-1);

const plural = (n: number, one: string, many: string) => (n === 1 ? one : many);
const stats = [
  location.beachDistanceM !== undefined && {
    value: `${location.beachDistanceM.toLocaleString('pt-BR')} m`,
    label: 'da praia',
  },
  facts.areaM2 !== undefined && {
    value: `${facts.areaM2.toLocaleString('pt-BR')} m²`,
    label: 'privativos',
  },
  facts.bedrooms !== undefined && {
    value: String(facts.bedrooms),
    label: plural(facts.bedrooms, 'quarto', 'quartos'),
  },
  facts.bathrooms !== undefined && {
    value: String(facts.bathrooms),
    label: plural(facts.bathrooms, 'banheiro', 'banheiros'),
  },
].filter((s): s is { value: string; label: string } => Boolean(s));
---

<section
  class:list={[
    'hero',
    { 'hero--photo': hero, 'hero--plain': !hero, 'hero--with-strip': withStrip },
  ]}
  aria-labelledby="hero-title"
>
  <div class="hero__media">
    {hero ? (
      <Photo
        src={heroImage ?? hero.src}
        alt={hero.alt}
        focus={hero.focus}
        sizes="100vw"
        priority
        class="hero__img"
      />
    ) : (
      <PhotoPlaceholder hint="Hero — foto horizontal de alto impacto (terraço ou fachada)" fill />
    )}
    <div class="hero__scrim" aria-hidden="true"></div>
  </div>

  <div class="container hero__content">
    <p class="hero__place">
      <Icon name="map-pin" size={16} />
      <span>{place}</span>
    </p>
    <h1 id="hero-title" class="hero__title">
      {nameLead && <>{nameLead} </>}
      <em>{nameLast}</em>
    </h1>
    {content.tagline && <p class="hero__tagline">{content.tagline}</p>}

    {(showBookingCta || tourTarget) && (
      <div class="hero__actions">
        {showBookingCta && (
          <Button href="#reservas" variant="inverse" size="lg" icon="arrow-right">
            Ver opções de reserva
          </Button>
        )}
        {tourTarget && (
          <Button href={tourTarget} variant="inverse-outline" size="lg">
            Conhecer o apartamento
          </Button>
        )}
      </div>
    )}

    {stats.length > 0 && (
      <dl class="hero__stats">
        {stats.map((s) => (
          <div class="hero__stat">
            <dt class="sr-only">{s.label}</dt>
            <dd>
              <span class="hero__stat-value">{s.value}</span>
              <span class="hero__stat-label" aria-hidden="true">
                {s.label}
              </span>
            </dd>
          </div>
        ))}
      </dl>
    )}
  </div>
</section>

<style>
  .hero {
    position: relative;
    display: grid;
    align-items: end;
    min-block-size: min(100svh, 820px);
    padding-block: calc(var(--space-9) + var(--space-2)) var(--space-8);
    color: var(--color-on-photo);
    isolation: isolate;
    overflow: hidden;
  }
  /* Espaço para a faixa que sobrepõe a base do hero */
  .hero--with-strip {
    padding-block-end: calc(var(--space-8) + var(--strip-overlap));
  }
  @media (min-width: 1024px) {
    .hero {
      min-block-size: min(100svh, 940px);
      padding-block-end: var(--space-9);
    }
    .hero--with-strip {
      padding-block-end: calc(var(--space-8) + var(--strip-overlap));
    }
  }

  .hero--plain {
    min-block-size: clamp(28rem, 68svh, 42rem);
    background:
      radial-gradient(120% 80% at 85% 0%, var(--sea-700) 0%, transparent 60%), var(--sea-950);
  }

  .hero__media {
    position: absolute;
    inset: 0;
    z-index: -1;
  }
  .hero__media :global(.hero__img) {
    position: absolute;
    inset: 0;
    block-size: 100%;
  }
  /*
   * Véu de legibilidade. Garante contraste do texto branco mesmo sobre áreas
   * claras da foto. Mobile: texto ocupa a largura toda, do meio para baixo →
   * véu vertical. Desktop: texto na coluna esquerda → véu lateral + vertical;
   * o lado direito da foto (guarda-sol e mata) fica limpo e luminoso.
   */
  .hero__scrim {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      180deg,
      rgb(8 38 54 / 0.55) 0%,
      rgb(8 38 54 / 0.15) 18%,
      rgb(8 38 54 / 0.62) 42%,
      rgb(8 38 54 / 0.9) 100%
    );
  }
  @media (min-width: 768px) {
    .hero__scrim {
      background:
        linear-gradient(
          90deg,
          rgb(8 38 54 / 0.82) 0%,
          rgb(8 38 54 / 0.62) 36%,
          rgb(8 38 54 / 0.08) 66%,
          rgb(8 38 54 / 0) 100%
        ),
        var(--scrim);
    }
  }
  .hero--plain .hero__scrim {
    background: linear-gradient(180deg, rgb(8 38 54 / 0.35), rgb(8 38 54 / 0.75));
  }

  .hero__content {
    display: grid;
    gap: var(--space-5);
    justify-items: start;
  }

  .hero__place {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    font-size: var(--text-xs);
    font-weight: var(--font-weight-strong);
    letter-spacing: var(--tracking-eyebrow);
    text-transform: uppercase;
  }

  .hero__title {
    max-inline-size: 12ch;
    font-size: var(--text-5xl);
    font-weight: var(--font-weight-regular);
    line-height: 0.96;
    color: var(--color-on-photo);
  }
  .hero__title em {
    color: var(--sand-100);
  }
  /* Sombra só sobre foto (ajuda a legibilidade); no fundo liso criaria halo */
  .hero--photo .hero__title {
    text-shadow: 0 2px 30px rgb(8 38 54 / 0.35);
  }

  .hero__tagline {
    max-inline-size: 30ch;
    font-family: var(--font-display);
    font-size: var(--text-xl);
    font-style: italic;
    line-height: var(--leading-snug);
    color: var(--sand-50);
  }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    margin-top: var(--space-1);
  }
  @media (max-width: 479px) {
    .hero__actions {
      inline-size: 100%;
    }
    .hero__actions :global(.btn) {
      flex: 1 1 100%;
    }
  }

  /* Números que decidem: linha fina separando, numerais em serifa */
  .hero__stats {
    display: grid;
    grid-template-columns: repeat(4, auto);
    justify-content: start;
    gap: var(--space-5);
    margin-top: var(--space-3);
    padding-top: var(--space-5);
    border-top: var(--border-width) solid rgb(255 255 255 / 0.28);
    inline-size: 100%;
    max-inline-size: 34rem;
  }
  @media (max-width: 379px) {
    .hero__stats {
      gap: var(--space-4);
    }
  }
  .hero__stat dd {
    display: grid;
    gap: 2px;
    margin: 0;
  }
  .hero__stat-value {
    font-family: var(--font-display);
    font-size: var(--text-2xl);
    line-height: 1;
    letter-spacing: var(--tracking-display);
    white-space: nowrap;
  }
  .hero__stat-label {
    font-size: var(--text-xs);
    letter-spacing: 0.04em;
    color: var(--sea-100);
  }

  /*
   * Entrada discreta dos elementos SECUNDÁRIOS (desligada com reduced-motion).
   * O título (elemento LCP) nunca começa invisível: se a animação atrasar ou
   * for pausada, o nome do residencial continua legível desde o 1º quadro.
   */
  @media (prefers-reduced-motion: no-preference) {
    .hero__content > :not(.hero__title) {
      animation: hero-in var(--duration-slow) var(--ease-out) both;
    }
    .hero__tagline {
      animation-delay: 120ms;
    }
    .hero__actions {
      animation-delay: 220ms;
    }
    .hero__stats {
      animation-delay: 320ms;
    }
    .hero--photo :global(.hero__img) {
      animation: hero-zoom 1600ms var(--ease-out) both;
    }
  }
  @keyframes hero-in {
    from {
      opacity: 0;
      transform: translateY(14px);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }
  /* Leve recuo da foto ao carregar: sensação de profundidade */
  @keyframes hero-zoom {
    from {
      transform: scale(1.06);
    }
    to {
      transform: none;
    }
  }
</style>
