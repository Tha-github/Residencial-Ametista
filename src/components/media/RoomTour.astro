---
/**
 * Tour por ambiente: cada cômodo com texto curto e uma composição editorial
 * assimétrica das suas fotos (a forma muda com a quantidade de fotos).
 * Todas as fotos abrem no modo ampliado compartilhado (Lightbox), na ordem
 * do tour; fotos da galeria que não estão em nenhum cômodo vêm depois e
 * continuam acessíveis por "Ver todas as fotos".
 */
import type { LightboxItem } from '../../lib/media/prepare';
import { lightboxData } from '../../lib/media/prepare';
import Icon from '../ui/Icon.astro';
import Lightbox from './Lightbox.astro';
import Photo from './Photo.astro';

export interface TourRoom {
  title: string;
  text?: string;
  items: LightboxItem[];
}

interface Props {
  rooms: TourRoom[];
  /** Todas as fotos, na ordem de navegação do modo ampliado. */
  items: LightboxItem[];
}

const { rooms, items } = Astro.props;
const total = items.length;
const MAX_VISIBLE = 4;
const shown = new Set(rooms.flatMap((r) => r.items.slice(0, MAX_VISIBLE).map((i) => i.index)));
const hiddenItems = items.filter((i) => !shown.has(i.index));
const pad = (n: number) => String(n).padStart(2, '0');
---

<div class="tour" data-gallery>
  {rooms.map((room, r) => {
    const visible = room.items.slice(0, MAX_VISIBLE);
    const more = room.items.length - visible.length;
    return (
      <article class="room" data-flip={r % 2 === 1 ? '' : undefined}>
        <div class="room__text reveal">
          <p class="room__num" aria-hidden="true">
            {pad(r + 1)}
          </p>
          <h3 class="room__title">{room.title}</h3>
          {room.text && <p class="room__desc">{room.text}</p>}
          <p class="room__count">
            <Icon name="image" size={16} />
            {room.items.length} {room.items.length === 1 ? 'foto' : 'fotos'}
            {more > 0 && <span> · toque para ver todas</span>}
          </p>
        </div>
        <ul class="room__photos" role="list" data-count={Math.min(visible.length, 4)}>
          {visible.map((item, i) => (
            <li class="room__photo">
              <a class="tour__link" {...lightboxData(item)}>
                <Photo
                  src={item.image}
                  alt=""
                  focus={item.photo.focus}
                  sizes={
                    i === 0 ? '(min-width: 1024px) 45vw, 100vw' : '(min-width: 1024px) 25vw, 33vw'
                  }
                />
                <span class="tour__zoom" aria-hidden="true">
                  <Icon name="expand" size={16} />
                </span>
              </a>
            </li>
          ))}
        </ul>
      </article>
    );
  })}

  {/* Fotos fora da composição: presentes para o modo ampliado e sem JS. */}
  {hiddenItems.length > 0 && (
    <ul class="tour__extra" role="list" hidden>
      {hiddenItems.map((item) => (
        <li>
          <a {...lightboxData(item)}>{item.label}</a>
        </li>
      ))}
    </ul>
  )}

  {total > 0 && (
    <div class="tour__all">
      <a class="btn btn--secondary btn--lg" href={items[0].large.src} data-gallery-open="0">
        Ver todas as {total} fotos
        <Icon name="expand" size={18} />
      </a>
    </div>
  )}

  <Lightbox total={total} />
</div>

<style>
  .tour {
    display: grid;
    gap: var(--space-9);
  }

  /* ---------- Cômodo: texto + composição ---------- */
  .room {
    display: grid;
    gap: var(--space-5);
  }
  @media (min-width: 1024px) {
    .room {
      grid-template-columns: minmax(0, 4fr) minmax(0, 8fr);
      align-items: center;
      gap: var(--space-8);
    }
    .room[data-flip] {
      grid-template-columns: minmax(0, 8fr) minmax(0, 4fr);
    }
    .room[data-flip] .room__text {
      order: 2;
    }
  }

  .room__text {
    display: grid;
    gap: var(--space-3);
    align-content: center;
    max-inline-size: 30rem;
  }
  .room__num {
    font-family: var(--font-display);
    font-size: var(--text-3xl);
    font-style: italic;
    line-height: 1;
    color: var(--color-eyebrow);
  }
  .room__title {
    font-size: var(--text-2xl);
    line-height: var(--leading-tight);
  }
  .room__desc {
    color: var(--color-text-muted);
  }
  .room__count {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    font-size: var(--text-sm);
    font-weight: var(--font-weight-strong);
    color: var(--color-accent);
  }

  /* ---------- Composição de fotos ---------- */
  .room__photos {
    --row: clamp(5.5rem, 18vw, 9rem);
    display: grid;
    gap: var(--space-2);
    padding: 0;
    list-style: none;
  }
  @media (min-width: 768px) {
    .room__photos {
      --row: clamp(8rem, 14vw, 13.5rem);
      gap: var(--space-3);
    }
  }

  /* 1 foto: horizontal ampla */
  .room__photos[data-count='1'] {
    grid-template-rows: calc(var(--row) * 2.4);
  }
  /* 2 fotos: escalonadas (a segunda desce meia linha) */
  .room__photos[data-count='2'] {
    grid-template-columns: repeat(2, minmax(0, 1fr));
    grid-template-rows: repeat(3, var(--row));
  }
  .room__photos[data-count='2'] > :nth-child(1) {
    grid-row: 1 / 3;
  }
  .room__photos[data-count='2'] > :nth-child(2) {
    grid-row: 2 / 4;
  }
  /* 3 fotos: uma alta + duas empilhadas */
  .room__photos[data-count='3'] {
    grid-template-columns: minmax(0, 3fr) minmax(0, 2fr);
    grid-template-rows: repeat(2, var(--row));
  }
  .room__photos[data-count='3'] > :nth-child(1) {
    grid-row: 1 / 3;
  }
  /* 4 fotos: mosaico assimétrico  A A B / C D D */
  .room__photos[data-count='4'] {
    grid-template-columns: repeat(3, minmax(0, 1fr));
    grid-template-rows: repeat(2, var(--row));
    grid-template-areas:
      'a a b'
      'c d d';
  }
  .room__photos[data-count='4'] > :nth-child(1) {
    grid-area: a;
  }
  .room__photos[data-count='4'] > :nth-child(2) {
    grid-area: b;
  }
  .room__photos[data-count='4'] > :nth-child(3) {
    grid-area: c;
  }
  .room__photos[data-count='4'] > :nth-child(4) {
    grid-area: d;
  }
  @media (min-width: 768px) {
    .room__photos[data-count='3'] {
      grid-template-rows: repeat(2, calc(var(--row) * 1.25));
    }
    .room__photos[data-count='4'] {
      grid-template-rows: var(--row) calc(var(--row) * 1.1);
    }
  }

  /*
   * Mobile: uma foto grande do ambiente e as demais como miniaturas logo
   * abaixo — legível na tela pequena, sem mosaico miúdo. Toque amplia.
   */
  @media (max-width: 767px) {
    .room__photos[data-count] {
      grid-template-columns: repeat(var(--thumbs, 1), minmax(0, 1fr));
      grid-template-rows: min(62vw, 22rem) min(24vw, 8rem);
      grid-template-areas: none;
    }
    .room__photos[data-count='1'] {
      grid-template-rows: min(66vw, 24rem);
    }
    .room__photos[data-count='2'] {
      --thumbs: 2;
      grid-template-rows: min(80vw, 28rem);
    }
    .room__photos[data-count='3'] {
      --thumbs: 2;
    }
    .room__photos[data-count='4'] {
      --thumbs: 3;
    }
    /* :nth-child(n) iguala a especificidade das regras do mosaico */
    .room__photos[data-count] > :nth-child(n) {
      grid-area: auto;
    }
    .room__photos[data-count]:not([data-count='2']) > :first-child {
      grid-column: 1 / -1;
    }
  }

  .room__photo {
    position: relative;
    min-block-size: 0;
    overflow: hidden;
    border-radius: var(--radius-md);
    background: var(--color-surface);
  }
  @media (min-width: 768px) {
    .room__photo {
      border-radius: var(--radius-lg);
    }
  }
  .tour__link {
    display: block;
    block-size: 100%;
    color: inherit;
  }
  .tour__link :global(picture) {
    display: block;
    block-size: 100%;
  }
  .tour__link :global(.photo) {
    block-size: 100%;
    transition: transform var(--duration-slow) var(--ease-out);
  }
  .tour__link:hover :global(.photo) {
    transform: scale(1.04);
  }
  .tour__link:focus-visible {
    outline-offset: -3px;
  }
  .tour__zoom {
    position: absolute;
    inset-block-end: var(--space-2);
    inset-inline-end: var(--space-2);
    display: grid;
    place-items: center;
    inline-size: 32px;
    block-size: 32px;
    border-radius: 50%;
    background: rgb(8 38 54 / 0.6);
    color: var(--white);
    opacity: 0;
    transition: opacity var(--duration-fast) var(--ease-out);
  }
  .tour__link:hover .tour__zoom,
  .tour__link:focus-visible .tour__zoom {
    opacity: 1;
  }
  @media (hover: none) {
    .room__photo:first-child .tour__zoom {
      opacity: 1;
    }
  }

  .tour__all {
    display: flex;
    justify-content: center;
  }
</style>
