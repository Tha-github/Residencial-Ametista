---
/**
 * Modo ampliado acessível, compartilhado pela grade de fotos e pelo tour.
 * Deve ficar DENTRO de um elemento `[data-gallery]`; os gatilhos são os
 * links `[data-gallery-item]` desse mesmo elemento (ver lib/media/prepare.ts).
 *
 * - Sem JavaScript: cada gatilho é um link para a imagem ampliada.
 * - Com JavaScript: <dialog> nativo (foco preso, Esc, fundo inerte),
 *   setas/Home/End, swipe, clique fora para fechar, foco devolvido ao gatilho.
 * - `[data-gallery-open="n"]` abre direto na foto n (ex.: "ver todas").
 */
import Icon from '../ui/Icon.astro';

interface Props {
  total: number;
}

const { total } = Astro.props;
---

<dialog class="lightbox" aria-label="Fotos do residencial em tamanho ampliado" data-lightbox>
  <div class="lightbox__bar">
    <p class="lightbox__counter" aria-live="polite" data-lightbox-counter></p>
    <button type="button" class="lightbox__btn" data-lightbox-close aria-label="Fechar">
      <Icon name="close" size={24} />
    </button>
  </div>
  <figure class="lightbox__figure">
    <span class="lightbox__spinner" aria-hidden="true"></span>
    <img class="lightbox__img" alt="" data-lightbox-img decoding="async" />
    <figcaption class="lightbox__caption" data-lightbox-caption hidden></figcaption>
  </figure>
  {total > 1 && (
    <>
      <button
        type="button"
        class="lightbox__btn lightbox__nav lightbox__nav--prev"
        data-lightbox-prev
        aria-label="Foto anterior"
      >
        <Icon name="chevron-left" size={28} />
      </button>
      <button
        type="button"
        class="lightbox__btn lightbox__nav lightbox__nav--next"
        data-lightbox-next
        aria-label="Próxima foto"
      >
        <Icon name="chevron-right" size={28} />
      </button>
    </>
  )}
</dialog>

<script>
  type Item = HTMLAnchorElement;

  for (const root of document.querySelectorAll<HTMLElement>('[data-gallery]')) {
    const dialog = root.querySelector<HTMLDialogElement>('[data-lightbox]');
    const img = root.querySelector<HTMLImageElement>('[data-lightbox-img]');
    const counter = root.querySelector<HTMLElement>('[data-lightbox-counter]');
    const caption = root.querySelector<HTMLElement>('[data-lightbox-caption]');
    if (!dialog || !img || !counter || !caption || typeof dialog.showModal !== 'function') continue;

    // Um gatilho por foto (o tour pode repetir uma foto: vale o primeiro).
    const byIndex = new Map<number, Item>();
    for (const el of root.querySelectorAll<Item>('[data-gallery-item]')) {
      const i = Number(el.dataset.galleryItem);
      if (!byIndex.has(i)) byIndex.set(i, el);
    }
    const items = [...byIndex.entries()].sort(([a], [b]) => a - b).map(([, el]) => el);
    if (items.length === 0) continue;
    let current = 0;
    let trigger: HTMLElement | null = null;

    const preload = (i: number) => {
      const item = items[(i + items.length) % items.length];
      const pre = new Image();
      pre.srcset = item.dataset.srcset ?? '';
      pre.sizes = '100vw';
      pre.src = item.href;
    };

    const show = (i: number) => {
      current = (i + items.length) % items.length;
      const item = items[current];
      dialog.dataset.loading = '';
      img.removeAttribute('srcset');
      img.width = Number(item.dataset.width);
      img.height = Number(item.dataset.height);
      img.alt = item.dataset.alt ?? '';
      img.sizes = '100vw';
      img.srcset = item.dataset.srcset ?? '';
      img.src = item.href;
      const text = item.dataset.caption;
      caption.textContent = text ?? '';
      caption.hidden = !text;
      counter.textContent = `Foto ${current + 1} de ${items.length}`;
      if (items.length > 1) {
        preload(current + 1);
        preload(current - 1);
      }
    };

    img.addEventListener('load', () => delete dialog.dataset.loading);
    img.addEventListener('error', () => delete dialog.dataset.loading);

    const open = (i: number, from: HTMLElement) => {
      trigger = from;
      show(i);
      dialog.showModal();
    };

    root.addEventListener('click', (event) => {
      const target = (event.target as HTMLElement).closest<HTMLElement>(
        '[data-gallery-item], [data-gallery-open]',
      );
      if (!target || dialog.contains(target)) return;
      // Ctrl/Cmd/Shift/clique do meio: comportamento normal do link.
      const e = event as MouseEvent;
      if (e.metaKey || e.ctrlKey || e.shiftKey || e.button === 1) return;
      event.preventDefault();
      open(Number(target.dataset.galleryItem ?? target.dataset.galleryOpen ?? 0), target);
    });

    root.querySelector('[data-lightbox-prev]')?.addEventListener('click', () => show(current - 1));
    root.querySelector('[data-lightbox-next]')?.addEventListener('click', () => show(current + 1));
    root.querySelector('[data-lightbox-close]')?.addEventListener('click', () => dialog.close());

    dialog.addEventListener('keydown', (event) => {
      if (items.length < 2) return;
      const actions: Record<string, () => void> = {
        ArrowRight: () => show(current + 1),
        ArrowLeft: () => show(current - 1),
        Home: () => show(0),
        End: () => show(items.length - 1),
      };
      const action = actions[event.key];
      if (action) {
        event.preventDefault();
        action();
      }
    });

    // Clique no fundo (fora da imagem e dos controles) fecha.
    dialog.addEventListener('click', (event) => {
      const t = event.target as HTMLElement;
      if (t === dialog || t.classList.contains('lightbox__figure')) dialog.close();
    });

    // Gesto de arrastar lateralmente no toque.
    let startX = 0;
    let startY = 0;
    dialog.addEventListener('pointerdown', (e) => {
      startX = e.clientX;
      startY = e.clientY;
    });
    dialog.addEventListener('pointerup', (e) => {
      if (e.pointerType === 'mouse' || items.length < 2) return;
      const dx = e.clientX - startX;
      if (Math.abs(dx) > 50 && Math.abs(dx) > Math.abs(e.clientY - startY)) {
        show(current + (dx < 0 ? 1 : -1));
      }
    });

    // Ao fechar, o foco volta para o gatilho da foto atual (se visível)
    // ou para o elemento que abriu o modo ampliado.
    dialog.addEventListener('close', () => {
      const visibleItem = items[current];
      const back = visibleItem.closest('[hidden]') ? trigger : visibleItem;
      back?.focus();
    });
  }
</script>

<style>
  .lightbox {
    inline-size: 100vw;
    max-inline-size: 100vw;
    block-size: 100dvh;
    max-block-size: 100dvh;
    margin: 0;
    padding: 0;
    border: 0;
    /* Opaco: contador e legenda nunca ficam sobre o conteúdo da página */
    background: #05141d;
    color: var(--white);
    overscroll-behavior: contain;
  }
  .lightbox[open] {
    display: grid;
    grid-template-rows: auto minmax(0, 1fr);
  }
  .lightbox::backdrop {
    background: rgb(5 20 29 / 0.6);
  }
  :global(html:has(.lightbox[open])) {
    overflow: hidden;
  }

  .lightbox__bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-4);
    padding: var(--space-2) var(--space-3) var(--space-2) var(--gutter);
  }
  .lightbox__counter {
    font-size: var(--text-sm);
    font-variant-numeric: tabular-nums;
    color: var(--sea-200);
  }

  .lightbox__figure {
    position: relative;
    display: grid;
    grid-template-rows: minmax(0, 1fr) auto;
    justify-items: center;
    align-items: center;
    gap: var(--space-3);
    min-block-size: 0;
    padding: 0 var(--space-2) var(--space-4);
  }
  @media (min-width: 768px) {
    .lightbox__figure {
      padding: 0 calc(var(--space-9) + var(--space-2)) var(--space-5);
    }
  }
  .lightbox__img {
    max-inline-size: 100%;
    max-block-size: 100%;
    inline-size: auto;
    block-size: auto;
    object-fit: contain;
    border-radius: var(--radius-sm);
    transition: opacity var(--duration-base) var(--ease-out);
  }
  .lightbox[data-loading] .lightbox__img {
    opacity: 0.35;
  }
  /* Indicador de carregamento: aparece só se a foto demorar (> 250ms) */
  .lightbox__spinner {
    position: absolute;
    inset-block-start: 50%;
    inset-inline-start: 50%;
    inline-size: 40px;
    block-size: 40px;
    margin: -20px 0 0 -20px;
    border: 3px solid rgb(255 255 255 / 0.2);
    border-top-color: var(--white);
    border-radius: 50%;
    opacity: 0;
    pointer-events: none;
  }
  .lightbox[data-loading] .lightbox__spinner {
    opacity: 1;
    transition: opacity var(--duration-fast) 250ms;
    animation: lightbox-spin 0.9s linear infinite;
  }
  @keyframes lightbox-spin {
    to {
      rotate: 1turn;
    }
  }
  .lightbox__caption {
    max-inline-size: var(--width-prose);
    font-size: var(--text-sm);
    text-align: center;
    color: var(--sand-100);
  }

  .lightbox__btn {
    display: grid;
    place-items: center;
    inline-size: 48px;
    block-size: 48px;
    padding: 0;
    border: 0;
    border-radius: 50%;
    background: transparent;
    color: var(--white);
    cursor: pointer;
    transition: background-color var(--duration-fast) var(--ease-out);
  }
  .lightbox__btn:hover {
    background: rgb(255 255 255 / 0.12);
  }
  .lightbox__btn:focus-visible {
    outline-color: var(--white);
  }
  .lightbox__nav {
    position: absolute;
    inset-block-start: 50%;
    translate: 0 -50%;
    background: rgb(5 20 29 / 0.55);
  }
  .lightbox__nav--prev {
    inset-inline-start: var(--space-2);
  }
  .lightbox__nav--next {
    inset-inline-end: var(--space-2);
  }
  @media (min-width: 768px) {
    .lightbox__nav--prev {
      inset-inline-start: var(--space-5);
    }
    .lightbox__nav--next {
      inset-inline-end: var(--space-5);
    }
  }
</style>
