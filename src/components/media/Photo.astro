---
/**
 * Foto real do imóvel, otimizada no build (AVIF + WebP + fallback JPEG),
 * com dimensões/aspect-ratio definidos para evitar CLS.
 * `priority`: imagem LCP (hero) — sem lazy-load e com fetchpriority alto.
 */
import type { ImageMetadata } from 'astro';
import { Picture } from 'astro:assets';
import { resolvePhoto } from '../../lib/media/photos';
import { responsiveWidths } from '../../styles/breakpoints';

interface Props {
  /** Caminho em src/assets/photos ou imagem já importada. */
  src: string | ImageMetadata;
  alt: string;
  sizes: string;
  /** Proporção de exibição, ex.: "4 / 3". Sem ela, usa a proporção original. */
  aspect?: string;
  /** Ponto focal para o recorte (object-position), ex.: "50% 35%". */
  focus?: string;
  priority?: boolean;
  class?: string;
}

const {
  src,
  alt,
  sizes,
  aspect,
  focus = '50% 50%',
  priority = false,
  class: className,
} = Astro.props;
const remote = typeof src === 'string' && src.startsWith('/media/');
const image = typeof src === 'string' && !remote ? resolvePhoto(src) : src;
const widths = typeof image === 'string' ? [] : responsiveWidths(image.width);
---

{remote ? (
  <img
    src={image as string}
    alt={alt}
    width="1600"
    height="1200"
    sizes={sizes}
    loading={priority ? 'eager' : 'lazy'}
    decoding={priority ? 'auto' : 'async'}
    fetchpriority={priority ? 'high' : 'auto'}
    class:list={['photo', className]}
    style={`${aspect ? `aspect-ratio: ${aspect};` : ''} object-position: ${focus};`}
  />
) : (
  <Picture
    src={image as ImageMetadata}
    alt={alt}
    formats={['avif', 'webp']}
    fallbackFormat="jpg"
    widths={widths}
    sizes={sizes}
    quality={78}
    loading={priority ? 'eager' : 'lazy'}
    decoding={priority ? 'auto' : 'async'}
    fetchpriority={priority ? 'high' : 'auto'}
    class:list={['photo', className]}
    style={`${aspect ? `aspect-ratio: ${aspect};` : ''} object-position: ${focus};`}
  />
)}

<style>
  :global(.photo) {
    inline-size: 100%;
    block-size: auto;
    object-fit: cover;
    background: var(--color-surface);
  }
</style>
