---
/**
 * Galeria: grade editorial + modo ampliado (lightbox) acessível.
 *
 * - Ordem narrativa (fachada → social → quartos → terraço → detalhes) via
 *   `group`; sem grupos, mantém a ordem enviada.
 * - Até GRID_VISIBLE fotos na grade; todas navegáveis no modo ampliado.
 * - Sem JavaScript: cada miniatura é um link para a imagem ampliada.
 * - Com JavaScript: <dialog> nativo (foco preso, Esc, fundo inerte),
 *   setas/Home/End, swipe, clique fora para fechar, foco devolvido ao gatilho.
 * - Legenda só se fornecida — nenhum cômodo é rotulado por inferência.
 * - Sem fotos: placeholders fora de produção; nada em produção.
 */
import { GRID_VISIBLE, orderGallery, type GalleryPhoto } from '../../lib/media/gallery';
import { prepareLightboxItems } from '../../lib/media/prepare';
import Icon from '../ui/Icon.astro';
import Lightbox from './Lightbox.astro';
import Photo from './Photo.astro';
import PhotoPlaceholder from './PhotoPlaceholder.astro';

interface Props {
  photos: GalleryPhoto[];
  /** Quantos placeholders mostrar em desenvolvimento quando não há fotos. */
  placeholderCount?: number;
}

const { photos, placeholderCount = 5 } = Astro.props;
const hints = ['Fachada / localização', 'Área social', 'Quarto', 'Terraço', 'Detalhe'];

const ordered = orderGallery(photos);
const total = ordered.length;

// Versões ampliadas (WebP responsivo) geradas no build para o modo ampliado.
const items = await prepareLightboxItems(ordered);
const visible = items.slice(0, GRID_VISIBLE);
const extra = items.slice(GRID_VISIBLE);
---

{total === 0 ? (
  <ul class="gallery__grid" role="list" data-count={placeholderCount}>
    {Array.from({ length: placeholderCount }, (_, i) => (
      <li class="gallery__item">
        <PhotoPlaceholder hint={hints[i % hints.length]} aspect={i === 0 ? '3 / 2' : '4 / 3'} />
      </li>
    ))}
  </ul>
) : (
  <div class="gallery" data-gallery>
    <ul class="gallery__grid" role="list" data-count={visible.length}>
      {visible.map(({ photo, index, image, width, height, large, label }) => (
        <li class="gallery__item">
          <a
            class="gallery__link"
            href={large.src}
            data-gallery-item={index}
            data-srcset={large.srcSet.attribute}
            data-alt={photo.alt}
            data-caption={photo.caption}
            data-width={width}
            data-height={height}
            aria-label={label}
          >
            <Photo
              src={image}
              alt=""
              focus={photo.focus}
              aspect={index === 0 ? '3 / 2' : '4 / 3'}
              sizes={
                index === 0 ? '(min-width: 1024px) 66vw, 100vw' : '(min-width: 1024px) 33vw, 50vw'
              }
            />
            <span class="gallery__zoom" aria-hidden="true">
              <Icon name="expand" size={18} />
            </span>
          </a>
        </li>
      ))}
    </ul>

    {/* Demais fotos: fora da grade, mas presentes para o modo ampliado e sem JS. */}
    {extra.length > 0 && (
      <ul class="gallery__extra" role="list" hidden>
        {extra.map(({ photo, index, width, height, large, label }) => (
          <li>
            <a
              href={large.src}
              data-gallery-item={index}
              data-srcset={large.srcSet.attribute}
              data-alt={photo.alt}
              data-caption={photo.caption}
              data-width={width}
              data-height={height}
              aria-label={label}
            >
              {label}
            </a>
          </li>
        ))}
      </ul>
    )}

    {total > visible.length && (
      <a class="btn btn--secondary gallery__all" href={items[0].large.src} data-gallery-open="0">
        Ver todas as {total} fotos
        <Icon name="expand" size={18} />
      </a>
    )}

    <Lightbox total={total} />
  </div>
)}

<style>
  /* ---------- Grade ---------- */
  .gallery__grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--space-2);
    padding: 0;
    list-style: none;
  }
  .gallery__item {
    position: relative;
    overflow: hidden;
    border-radius: var(--radius-md);
    background: var(--color-surface);
  }
  .gallery__item:first-child {
    grid-column: 1 / -1;
  }
  /* Quantidade par → sobra 1 na última linha de 2 colunas: ocupa a linha toda */
  .gallery__item:last-child:nth-child(even) {
    grid-column: 1 / -1;
  }
  .gallery__item:last-child:nth-child(even) :global(.photo) {
    aspect-ratio: 3 / 2 !important;
  }

  @media (min-width: 768px) {
    .gallery__grid {
      gap: var(--space-3);
    }
  }

  @media (min-width: 1024px) {
    .gallery__grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: var(--space-4);
    }
    /* Destaque 2×2; a altura vem da grade, não da proporção */
    .gallery__item:first-child {
      grid-column: span 2;
      grid-row: span 2;
    }
    .gallery__item:first-child :global(.photo),
    .gallery__item:first-child :global([data-placeholder]) {
      block-size: 100%;
      aspect-ratio: auto !important;
    }
    .gallery__item:last-child:nth-child(even) {
      grid-column: auto;
    }
    .gallery__item:last-child:nth-child(even) :global(.photo) {
      aspect-ratio: 4 / 3 !important;
    }
    /* Ajustes para não deixar buracos na última linha (linhas de 3 após as 3 primeiras) */
    [data-count='1'] .gallery__item:first-child {
      grid-column: 1 / -1;
      grid-row: auto;
    }
    [data-count='1'] .gallery__item:first-child :global(.photo) {
      aspect-ratio: 21 / 9 !important;
    }
    [data-count='2'] .gallery__item:nth-child(2) {
      grid-row: span 2;
    }
    [data-count='2'] .gallery__item:nth-child(2) :global(.photo) {
      block-size: 100%;
      aspect-ratio: auto !important;
    }
    [data-count='4'] .gallery__item:nth-child(4) {
      grid-column: 1 / -1;
    }
    [data-count='4'] .gallery__item:nth-child(4) :global(.photo) {
      aspect-ratio: 21 / 9 !important;
    }
    [data-count='5'] .gallery__item:nth-child(5) {
      grid-column: span 2;
    }
    [data-count='5'] .gallery__item:nth-child(5) :global(.photo) {
      aspect-ratio: auto !important;
      block-size: 100%;
    }
  }

  .gallery__link {
    display: block;
    block-size: 100%;
    color: inherit;
  }
  /* <picture> é inline por padrão e não tem altura: sem isto a foto não
     consegue preencher células que esticam (destaque 2×2, última linha). */
  .gallery__link :global(picture) {
    display: block;
    block-size: 100%;
  }
  .gallery__link :global(.photo) {
    block-size: 100%;
    transition: transform var(--duration-slow) var(--ease-out);
  }
  .gallery__link:hover :global(.photo) {
    transform: scale(1.03);
  }
  .gallery__link:focus-visible {
    outline-offset: -3px;
  }
  .gallery__zoom {
    position: absolute;
    inset-block-end: var(--space-3);
    inset-inline-end: var(--space-3);
    display: grid;
    place-items: center;
    inline-size: 36px;
    block-size: 36px;
    border-radius: 50%;
    background: rgb(8 38 54 / 0.6);
    color: var(--white);
    opacity: 0;
    transition: opacity var(--duration-fast) var(--ease-out);
  }
  .gallery__link:hover .gallery__zoom,
  .gallery__link:focus-visible .gallery__zoom {
    opacity: 1;
  }
  @media (hover: none) {
    .gallery__zoom {
      opacity: 1;
    }
  }

  .gallery__all {
    margin-top: var(--space-5);
  }
</style>
