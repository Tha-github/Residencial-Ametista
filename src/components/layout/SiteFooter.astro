---
/**
 * Rodapé completo: marca e localização, navegação (seções publicadas),
 * reservas (plataformas fornecidas) e contato (canais fornecidos).
 * Colunas sem dados não aparecem.
 */
import type { PropertyContent } from '../../data/property.schema';
import { bookingLinks, formatPlace, instagramHandle } from '../../lib/content/format';
import Icon from '../ui/Icon.astro';

interface Props {
  content: PropertyContent;
  nav?: { href: string; label: string }[];
}

const { content, nav = [] } = Astro.props;
const place = formatPlace(content.location);
const links = bookingLinks(content);
const { instagram, whatsapp, email } = content.contact;
const hasContact = Boolean(instagram || whatsapp || email);
const { streetAddress, neighborhood, city, stateCode, postalCode, mapsUrl } = content.location;
const checkIn = content.practicalInfo.checkIn;
const year = new Date().getFullYear();
const cols =
  1 + [streetAddress, nav.length > 0, links.length > 0, hasContact].filter(Boolean).length;
---

<footer class="site-footer section--inverse">
  <div class="container">
    <div class="site-footer__grid" data-cols={cols}>
      <div class="site-footer__about">
        <p class="site-footer__brand">{content.name}</p>
        {content.tagline ? (
          <p class="site-footer__place">{content.tagline}</p>
        ) : (
          <p class="site-footer__place">{place}</p>
        )}
        {links.length > 0 && (
          <p class="site-footer__note">
            Reservas concluídas nas plataformas externas indicadas neste site.
          </p>
        )}
      </div>

      {streetAddress && (
        <div>
          <p class="site-footer__heading">Endereço</p>
          <address class="site-footer__address">
            {streetAddress}
            {neighborhood && (
              <>
                <br />
                {neighborhood}
              </>
            )}
            <br />
            {city} · {stateCode}
            {postalCode && <> · {postalCode}</>}
          </address>
          {mapsUrl && (
            <a
              class="link site-footer__map"
              href={mapsUrl}
              target="_blank"
              rel="noopener noreferrer"
            >
              <Icon name="map-pin" size={16} />
              Como chegar
              <span class="sr-only">(abre em nova aba)</span>
            </a>
          )}
          {checkIn && <p class="site-footer__checkin">Check-in: {checkIn.toLowerCase()}</p>}
        </div>
      )}

      {nav.length > 0 && (
        <nav aria-label="Rodapé">
          <p class="site-footer__heading">Navegação</p>
          <ul role="list">
            {nav.map((item) => (
              <li>
                <a class="link" href={item.href}>
                  {item.label}
                </a>
              </li>
            ))}
          </ul>
        </nav>
      )}

      {links.length > 0 && (
        <div>
          <p class="site-footer__heading">Reservar</p>
          <ul role="list">
            {links.map((link) => (
              <li>
                <a class="link" href={link.url} target="_blank" rel="noopener noreferrer">
                  {link.name}
                  <span class="sr-only">(abre em nova aba)</span>
                </a>
              </li>
            ))}
          </ul>
        </div>
      )}

      {hasContact && (
        <div>
          <p class="site-footer__heading">Contato</p>
          <ul role="list">
            {whatsapp && (
              <li>
                <a class="link" href={whatsapp} target="_blank" rel="noopener noreferrer">
                  WhatsApp
                  <span class="sr-only">(abre em nova aba)</span>
                </a>
              </li>
            )}
            {instagram && (
              <li>
                <a class="link" href={instagram} target="_blank" rel="noopener noreferrer">
                  Instagram {instagramHandle(instagram)}
                  <span class="sr-only">(abre em nova aba)</span>
                </a>
              </li>
            )}
            {email && (
              <li>
                <a class="link" href={`mailto:${email}`}>
                  {email}
                </a>
              </li>
            )}
          </ul>
        </div>
      )}
    </div>

    <p class="site-footer__legal">
      © {year} {content.name}
    </p>
  </div>
</footer>

<style>
  .site-footer {
    padding-block: var(--space-8) var(--space-6);
    font-size: var(--text-sm);
  }
  .site-footer__grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--space-7) var(--grid-gap);
  }
  .site-footer__about {
    grid-column: 1 / -1;
  }
  @media (min-width: 1024px) {
    .site-footer__about {
      grid-column: auto;
    }
    .site-footer__grid {
      grid-template-columns: 1.6fr repeat(3, minmax(0, 1fr));
    }
    .site-footer__grid[data-cols='2'] {
      grid-template-columns: 1.6fr minmax(0, 1fr);
    }
    .site-footer__grid[data-cols='3'] {
      grid-template-columns: 1.6fr repeat(2, minmax(0, 1fr));
    }
    .site-footer__grid[data-cols='5'] {
      grid-template-columns: 1.6fr repeat(4, minmax(0, 1fr));
    }
  }
  .site-footer__address {
    font-style: normal;
    line-height: var(--leading-normal);
    color: var(--color-inverse-muted);
  }
  .site-footer__map {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    min-block-size: var(--tap-min);
  }
  .site-footer__checkin {
    color: var(--color-inverse-muted);
  }
  .site-footer__brand {
    font-family: var(--font-display);
    font-size: var(--text-2xl);
    font-weight: var(--font-weight-display);
    letter-spacing: var(--tracking-display);
  }
  .site-footer__place,
  .site-footer__note {
    margin-top: var(--space-2);
    color: var(--color-inverse-muted);
  }
  .site-footer__note {
    max-width: 34ch;
  }
  .site-footer__heading {
    margin-bottom: var(--space-3);
    font-size: var(--text-xs);
    font-weight: var(--font-weight-strong);
    letter-spacing: var(--tracking-eyebrow);
    text-transform: uppercase;
    color: var(--color-inverse-eyebrow);
  }
  ul {
    display: grid;
    gap: var(--space-1);
    padding: 0;
    list-style: none;
  }
  ul a {
    display: inline-flex;
    align-items: center;
    min-block-size: var(--tap-min);
    overflow-wrap: anywhere;
  }
  .site-footer__legal {
    margin-top: var(--space-8);
    padding-top: var(--space-5);
    border-top: var(--border-width) solid rgb(219 233 239 / 0.18);
    color: var(--color-inverse-muted);
    font-size: var(--text-xs);
  }
</style>
