---
/**
 * Cabeçalho fixo. `overlay`: transparente sobre o hero e sólido após rolar
 * (sem JS, permanece legível: o hero tem véu escuro no topo).
 * Navegação curta por âncoras — somente seções publicadas (sections.ts).
 * Sem o nome do residencial na barra (ele aparece no hero e no rodapé):
 * links à esquerda, "Reservar" à direita.
 * No mobile: menu compacto (<details>, funciona sem JavaScript; com JS
 * fecha ao escolher um item ou com Esc) + "Reservar" sempre visível.
 */
import Icon from '../ui/Icon.astro';

interface Props {
  overlay?: boolean;
  nav?: { href: string; label: string }[];
  /** Exibe o CTA "Reservar" (somente se houver links de plataforma). */
  bookingCta?: boolean;
}

const { overlay = false, nav = [], bookingCta = false } = Astro.props;
---

<header class="site-header" data-overlay={overlay ? '' : undefined} data-site-header>
  <div class="container site-header__inner">
    {(nav.length > 0 || bookingCta) && (
      <nav class="site-header__nav" aria-label="Seções do site">
        {nav.length > 0 && (
          <ul class="site-header__links" role="list">
            {nav.map((item) => (
              <li>
                <a href={item.href}>{item.label}</a>
              </li>
            ))}
          </ul>
        )}
        <div class="site-header__actions">
          {bookingCta && (
            <a class="btn site-header__cta" href="#reservas">
              Reservar
            </a>
          )}
          {nav.length > 0 && (
            <details class="site-header__menu" data-menu>
              <summary aria-label="Menu de seções">
                <span class="site-header__icon site-header__icon--open">
                  <Icon name="menu" size={24} />
                </span>
                <span class="site-header__icon site-header__icon--close">
                  <Icon name="close" size={24} />
                </span>
              </summary>
              <div class="site-header__panel">
                <ul class="site-header__panel-links" role="list">
                  {nav.map((item) => (
                    <li>
                      <a href={item.href}>{item.label}</a>
                    </li>
                  ))}
                </ul>
                {bookingCta && (
                  <a class="btn btn--lg site-header__panel-cta" href="#reservas">
                    Ver opções de reserva
                    <Icon name="arrow-right" size={18} />
                  </a>
                )}
              </div>
            </details>
          )}
        </div>
      </nav>
    )}
  </div>
</header>
{overlay && <div class="site-header__sentinel" data-header-sentinel aria-hidden="true"></div>}

<script>
  const header = document.querySelector<HTMLElement>('[data-site-header][data-overlay]');
  const sentinel = document.querySelector('[data-header-sentinel]');
  if (header && sentinel && 'IntersectionObserver' in window) {
    new IntersectionObserver(([entry]) => {
      header.toggleAttribute('data-scrolled', !entry.isIntersecting);
    }).observe(sentinel);
  }

  const menu = document.querySelector<HTMLDetailsElement>('[data-menu]');
  if (menu) {
    menu.addEventListener('click', (e) => {
      if ((e.target as HTMLElement).closest('a')) menu.open = false;
    });
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && menu.open) {
        menu.open = false;
        menu.querySelector('summary')?.focus();
      }
    });
    document.addEventListener('click', (e) => {
      if (menu.open && !menu.contains(e.target as Node)) menu.open = false;
    });
  }
</script>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: var(--z-header);
    background: rgb(250 247 242 / 0.92);
    backdrop-filter: saturate(1.4) blur(12px);
    border-bottom: var(--border-width) solid var(--color-border);
    color: var(--color-heading);
    transition:
      background-color var(--duration-base) var(--ease-out),
      border-color var(--duration-base) var(--ease-out),
      color var(--duration-base) var(--ease-out);
  }
  .site-header[data-overlay] {
    position: fixed;
    inset-inline: 0;
    background: transparent;
    backdrop-filter: none;
    border-bottom-color: transparent;
    color: var(--color-on-photo);
  }
  .site-header[data-overlay][data-scrolled] {
    background: rgb(250 247 242 / 0.94);
    backdrop-filter: saturate(1.4) blur(12px);
    border-bottom-color: var(--color-border);
    color: var(--color-heading);
  }
  .site-header__sentinel {
    position: absolute;
    top: 0;
    block-size: 80px;
    inline-size: 1px;
    pointer-events: none;
  }
  .site-header__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-4);
    min-block-size: 4.25rem;
  }
  .site-header__nav {
    display: flex;
    flex: 1;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-4);
  }
  .site-header__actions {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    margin-inline-start: auto;
  }
  .site-header__links {
    display: none;
    gap: var(--space-6);
    padding: 0;
    list-style: none;
  }
  @media (min-width: 1024px) {
    .site-header__links {
      display: flex;
    }
  }
  .site-header__links a {
    display: inline-flex;
    align-items: center;
    min-block-size: var(--tap-min);
    font-size: var(--text-sm);
    font-weight: var(--font-weight-strong);
    text-decoration: none;
    background: linear-gradient(currentColor, currentColor) no-repeat left 75% / 0 1px;
    transition: background-size var(--duration-base) var(--ease-out);
  }
  .site-header__links a:hover {
    background-size: 100% 1px;
  }
  .site-header__cta {
    min-block-size: 44px;
    padding-block: var(--space-2);
    padding-inline: var(--space-5);
  }
  /* Sobre a foto, o CTA é claro; depois de rolar, volta ao azul */
  .site-header[data-overlay]:not([data-scrolled]) .site-header__cta {
    --btn-bg: var(--sand-50);
    --btn-fg: var(--sea-950);
    --btn-bg-hover: var(--white);
    --btn-fg-hover: var(--sea-950);
  }
  .site-header[data-overlay]:not([data-scrolled]) .site-header__cta:focus-visible {
    outline-color: var(--white);
  }

  /* ---------- Menu compacto (< 1024px) ---------- */
  .site-header__menu {
    position: relative;
  }
  @media (min-width: 1024px) {
    .site-header__menu {
      display: none;
    }
  }
  .site-header__menu summary {
    display: grid;
    place-items: center;
    inline-size: var(--tap-min);
    block-size: var(--tap-min);
    border-radius: var(--radius-md);
    cursor: pointer;
    list-style: none;
    transition: background-color var(--duration-fast) var(--ease-out);
  }
  .site-header__menu summary::-webkit-details-marker {
    display: none;
  }
  .site-header__menu summary:hover {
    background: rgb(127 127 127 / 0.14);
  }
  /* Botão acima do painel: vira "fechar" (X) quando o menu está aberto */
  .site-header__menu summary {
    position: relative;
    z-index: 2;
  }
  .site-header__icon--close,
  .site-header__menu[open] .site-header__icon--open {
    display: none;
  }
  .site-header__menu[open] .site-header__icon--close {
    display: grid;
  }
  .site-header__menu[open] summary {
    color: var(--sea-950);
  }

  /* ---------- Painel em tela cheia (mobile/tablet) ---------- */
  .site-header__panel {
    position: fixed;
    inset: 0;
    z-index: 1;
    display: grid;
    grid-template-rows: 1fr auto;
    gap: var(--space-6);
    padding: calc(4.25rem + var(--space-6)) var(--gutter)
      calc(var(--space-7) + env(safe-area-inset-bottom));
    overflow-y: auto;
    background:
      radial-gradient(90% 50% at 100% 0%, var(--sea-100) 0%, transparent 70%), var(--sand-50);
    color: var(--color-title);
  }
  @media (prefers-reduced-motion: no-preference) {
    .site-header__menu[open] .site-header__panel {
      animation: menu-in var(--duration-base) var(--ease-out);
    }
  }
  @keyframes menu-in {
    from {
      opacity: 0;
      transform: translateY(-8px);
    }
  }
  .site-header__panel-links {
    display: grid;
    align-content: center;
    gap: var(--space-2);
    padding: 0;
    list-style: none;
    text-align: center;
  }
  .site-header__panel-links a {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-block-size: 56px;
    font-family: var(--font-display);
    font-size: var(--text-3xl);
    line-height: 1.1;
    text-decoration: none;
    transition: color var(--duration-fast) var(--ease-out);
  }
  .site-header__panel-links a:hover {
    color: var(--color-eyebrow);
  }
  .site-header__panel-cta {
    inline-size: 100%;
    max-inline-size: 24rem;
    justify-self: center;
  }
  /* Menu aberto: o painel ocupa a tela; a página não rola por trás.
     Sem backdrop-filter no header (ele prenderia o painel fixo ao header). */
  .site-header:has(.site-header__menu[open]) {
    backdrop-filter: none;
  }
  :global(html:has(.site-header__menu[open])) {
    overflow: hidden;
  }
  /* A barra de reserva fixa não fica por cima do menu aberto */
  :global(body:has(.site-header__menu[open]) .booking-bar) {
    display: none;
  }
</style>
