---
/**
 * Ícones de traço fino, inline (sem requisição extra, herdam `currentColor`).
 * Traçados baseados no Lucide (https://lucide.dev, licença ISC).
 * Conjunto mínimo e fechado: adicione aqui apenas o que for usado.
 * Renderizados a partir de dados (sem set:html).
 */
type Shape =
  | ['path', { d: string }]
  | ['circle', { cx: number; cy: number; r: number; fill?: string }]
  | ['rect', { width: number; height: number; x: number; y: number; rx: number }];

const p = (d: string): Shape => ['path', { d }];
const wave = (y: number) =>
  p(
    `M2 ${y}c.6.5 1.2 1 2.5 1C7 ${y + 1} 7 ${y - 1} 9.5 ${y - 1}c2.6 0 2.4 2 5 2 2.5 0 2.5-2 5-2 1.3 0 1.9.5 2.5 1`,
  );

const icons = {
  'arrow-right': [p('M5 12h14'), p('m12 5 7 7-7 7')],
  'arrow-up-right': [p('M7 7h10v10'), p('M7 17 17 7')],
  'arrow-down': [p('M12 5v14'), p('m19 12-7 7-7-7')],
  'map-pin': [
    p(
      'M20 10c0 4.993-5.539 10.193-7.399 11.799a1 1 0 0 1-1.202 0C9.539 20.193 4 14.993 4 10a8 8 0 0 1 16 0',
    ),
    ['circle', { cx: 12, cy: 10, r: 3 }],
  ],
  'chevron-left': [p('m15 18-6-6 6-6')],
  'chevron-right': [p('m9 18 6-6-6-6')],
  close: [p('M18 6 6 18'), p('m6 6 12 12')],
  expand: [p('M15 3h6v6'), p('M9 21H3v-6'), p('M21 3l-7 7'), p('M3 21l7-7')],
  image: [
    ['rect', { width: 18, height: 18, x: 3, y: 3, rx: 2 }],
    ['circle', { cx: 9, cy: 9, r: 2 }],
    p('m21 15-3.086-3.086a2 2 0 0 0-2.828 0L6 21'),
  ],
  waves: [wave(6), wave(12), wave(18)],
  message: [p('M7.9 20A9 9 0 1 0 4 16.1L2 22Z')],
  mail: [
    ['rect', { width: 20, height: 16, x: 2, y: 4, rx: 2 }],
    p('m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7'),
  ],
  camera: [
    ['rect', { width: 20, height: 20, x: 2, y: 2, rx: 5 }],
    ['circle', { cx: 12, cy: 12, r: 4 }],
    ['circle', { cx: 17.5, cy: 6.5, r: 0.5, fill: 'currentColor' }],
  ],
} satisfies Record<string, Shape[]>;

export type IconName = keyof typeof icons;

interface Props {
  name: IconName;
  size?: number;
  /** Rótulo acessível. Sem rótulo, o ícone é decorativo (aria-hidden). */
  label?: string;
  class?: string;
  strokeWidth?: number;
}

const { name, size = 20, label, class: className, strokeWidth = 1.6 } = Astro.props;
const shapes: Shape[] = icons[name];
---

<svg
  xmlns="http://www.w3.org/2000/svg"
  width={size}
  height={size}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width={strokeWidth}
  stroke-linecap="round"
  stroke-linejoin="round"
  class={className}
  data-icon={name}
  role={label ? 'img' : undefined}
  aria-label={label}
  aria-hidden={label ? undefined : 'true'}
  focusable="false"
>
  {shapes.map(([Tag, attrs]) => (
    <Tag {...attrs} />
  ))}
</svg>
