---
/**
 * Cabeçalho de seção: sobretítulo (opcional) + título + linha fina (opcional).
 * O texto vem sempre do conteúdo; o componente não define cópia própria.
 */
interface Props {
  id: string;
  title: string;
  eyebrow?: string;
  level?: 2 | 3;
  align?: 'start' | 'center';
  hideTitle?: boolean;
}

const { id, title, eyebrow, level = 2, align = 'start', hideTitle = false } = Astro.props;
const Heading = `h${level}` as const;
// `*trecho*` no título vira ênfase em itálico (texto puro; nunca HTML).
const parts = title.split(/\*(.+?)\*/);
---

<header class:list={['section-heading', `section-heading--${align}`]}>
  {eyebrow && <p class="eyebrow eyebrow--wave">{eyebrow}</p>}
  <Heading id={id} class:list={{ 'sr-only': hideTitle }}>
    {parts.map((part, i) => (i % 2 === 1 ? <em>{part}</em> : part))}
  </Heading>
  {Astro.slots.has('default') && (
    <div class="lead">
      <slot />
    </div>
  )}
</header>

<style>
  .section-heading {
    display: grid;
    gap: var(--space-4);
    margin-bottom: var(--space-7);
  }
  .section-heading :global(h2 em) {
    color: var(--color-accent);
  }
  :global(.section--inverse) .section-heading :global(h2 em) {
    color: var(--sea-200);
  }
  .section-heading--center {
    justify-items: center;
    text-align: center;
  }
</style>
