---
/** Painel administrativo, disponível também no ambiente local de desenvolvimento. */
import { getImage } from 'astro:assets';
import '../../admin-kit/admin.css';
import { listPhotos, resolvePhoto } from '../../lib/media/photos';

const thumbs = Object.fromEntries(
  await Promise.all(
    listPhotos().map(async (path) => {
      const img = await getImage({
        src: resolvePhoto(path),
        width: 640,
        format: 'webp',
        quality: 70,
      });
      return [path, img.src];
    }),
  ),
);

const apiUrl = (import.meta.env.PUBLIC_ADMIN_API_URL ?? '').replace(/\/$/, '');
const apiOrigin = (() => {
  try {
    return apiUrl ? new URL(apiUrl).origin : '';
  } catch {
    return '';
  }
})();
const csp = [
  "default-src 'self'",
  "script-src 'self'",
  "style-src 'self' 'unsafe-inline'",
  "img-src 'self' blob: data:",
  `connect-src 'self'${apiOrigin ? ` ${apiOrigin}` : ''}`,
  "font-src 'self'",
  "object-src 'none'",
  "base-uri 'none'",
  "form-action 'none'",
].join('; ');
---

<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta http-equiv="Content-Security-Policy" content={csp} />
    <meta name="referrer" content="no-referrer" />
    <meta name="robots" content="noindex, nofollow" />
    <link rel="icon" href="data:," />
    <title>Painel · Residencial Ametista</title>
  </head>
  <body>
    <div
      id="admin"
      data-api={apiOrigin ? apiUrl : import.meta.env.DEV ? '/__admin-worker' : ''}
      data-thumbs={JSON.stringify(thumbs)}
    >
      <noscript>Ative o JavaScript para usar o painel.</noscript>
    </div>
    <script>
      import { startAdmin } from '../../admin-kit/client/app';
      import { ametistaPreview } from '../../admin-sites/ametista-preview';
      import { ametistaSpec } from '../../admin-sites/ametista';
      import { propertySchema } from '../../data/property.schema';

      const root = document.getElementById('admin')!;
      startAdmin(root, {
        spec: ametistaSpec,
        apiBase: root.dataset.api ?? '',
        thumbs: JSON.parse(root.dataset.thumbs ?? '{}'),
        preview: ametistaPreview,
        validate(content) {
          const { $comment: _ignored, ...data } = content;
          const result = propertySchema.safeParse(data);
          return result.success
            ? []
            : result.error.issues.map((issue) => ({
                path: issue.path.join('.'),
                message: issue.message,
              }));
        },
      });
    </script>
  </body>
</html>
