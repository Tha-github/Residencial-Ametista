---
import HomePage from '../components/pages/HomePage.astro';
import { fileSource, loadContent } from '../lib/content/load';
import { adminEnv, PROPERTY_ID } from '../lib/admin/runtime';

export const prerender = false;

const database = adminEnv(Astro.locals).CONTENT_DB;
const stored = database
  ? await database
      .prepare('SELECT content_json FROM property_content WHERE property_id = ?')
      .bind(PROPERTY_ID)
      .first<{ content_json: string }>()
  : null;
const content = await loadContent(
  stored
    ? { name: 'Cloudflare D1', read: async () => JSON.parse(stored.content_json) }
    : fileSource,
);
---

<HomePage content={content} />
