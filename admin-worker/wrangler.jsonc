// Worker do painel administrativo (Top Site Admin) — Residencial Ametista.
// O fluxo de configuração pela tela /admin exige o binding KV ADMIN_KV e os
// secrets CONFIG_KEY e SESSION_SECRET. Ver docs/11-configuracao-login.md.
// Variáveis públicas aqui; segredos SOMENTE via `wrangler secret put`:
//   GITHUB_TOKEN         token fine-grained, só este repositório (Contents: RW, Actions: R)
//   ADMIN_PASSWORD_HASH  gerado por `npm run admin:hash-password`
//   SESSION_SECRET       texto aleatório longo (≥ 32 caracteres)
{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "ametista-admin",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-10",
  "kv_namespaces": [{ "binding": "ADMIN_KV", "id": "e9e247034b3049b58fc260d7418da6aa" }],
  "vars": {
    "GITHUB_REPO": "Tha-github/Residencial-Ametista",
    "GITHUB_BRANCH": "main",
    "ALLOWED_ORIGINS": "https://tha-github.github.io",
    "SESSION_HOURS": "8",
  },
  "observability": {
    "enabled": true,
  },
}
